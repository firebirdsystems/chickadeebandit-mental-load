{
  "scenarios": [
    {
      "name": "a one-sided pairing does not open the board",
      "members": {
        "a": "adult",
        "b": "adult"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_mental_load__partner_config (member_id, partner_id, session_id, created_at) VALUES (?, ?, ?, ?)",
          "params": [
            "{{a}}",
            "{{b}}",
            "sess-ab",
            "2026-01-01T00:00:00Z"
          ]
        },
        {
          "action": "open",
          "as": "a"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"view-setup\"]",
          "as": "a"
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_mental_load__partner_config (member_id, partner_id, session_id, created_at) VALUES (?, ?, ?, ?)",
          "params": [
            "{{b}}",
            "{{a}}",
            "sess-ab",
            "2026-01-01T00:00:00Z"
          ]
        },
        {
          "action": "reload",
          "as": "a"
        },
        {
          "action": "expectVisible",
          "selector": "[data-testid=\"view-main\"]",
          "as": "a"
        }
      ]
    },
